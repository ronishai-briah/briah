# להעתיק ל-.env.local (שלא נכנס ל-git) ולמלא כשיש פרויקט Supabase אמיתי.
# ARBOX_API_KEY *לא* מופיע כאן בכוונה — הוא לעולם לא משתנה סביבה של ה-frontend (VITE_*),
# כי כל דבר עם קידומת VITE_ נכנס ל-bundle הציבורי של הדפדפן. הוא secret רק בצד ה-Edge Function
# (ראו supabase/functions/arbox-proxy), מוגדר שם עם `supabase secrets set ARBOX_API_KEY=...`.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_FUNCTIONS_URL=
